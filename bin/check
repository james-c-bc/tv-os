#!/usr/bin/env bash
# Usage: bin/check [tv-name]
# Prints what the connected TV is: model, Android version, TCL firmware
# version, Android build, security patch, the current Home activity and
# whether launcherx and setupwraith are enabled or disabled, then the state of
# every package on lists/disable.txt.
set -euo pipefail
source "$(dirname "$0")/../lib/tv.sh"

require_adb
serial="$(tv_serial "${1:-}")"
require_connected "$serial"

tv() { adb -s "$serial" shell "$@" | tr -d '\r'; }

# TCL keeps its firmware version in its own property.
firmware="$(tv getprop ro.software.version_id)"

home="$(home_activity "$serial")"
now="$(tv_packages "$serial")"
echo "TV:               $serial"
echo "Model:            $(tv getprop ro.product.model)"
echo "Android version:  $(tv getprop ro.build.version.release)"
echo "Firmware:         ${firmware:-unknown}"
echo "Android build:    $(tv getprop ro.build.display.id)"
echo "Security patch:   $(tv getprop ro.build.version.security_patch)"
echo "Home activity:    $home"
# A firmware update may re-enable these, taking Home back from our app.
for pkg in "${STOCK_HOMES[@]}"; do
  state="$(awk -v p="$pkg" '$2 == p { print $1 }' <<< "$now")"
  printf '%-18s%s\n' "${pkg##*.}:" "${state:-not on TV}"
done

# How much of the debloat has stuck, e.g. after a firmware update.
disable="$(read_list disable)"
states="$(while read -r pkg; do
  [[ -n "$pkg" ]] || continue
  state="$(awk -v p="$pkg" '$2 == p { print $1 }' <<< "$now")"
  printf '  %-12s %s\n' "${state:-not on TV}" "$pkg"
done <<< "$disable")"
echo "Disable list:     $(grep -c '^  disabled ' <<< "$states" || true)" \
  "of $(grep -c . <<< "$states" || true) disabled"
[[ -z "$states" ]] || echo "$states"
