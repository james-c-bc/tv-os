#!/usr/bin/env bash
# Usage: bin/restore [snapshot | tv-name]
# Re-enables every package that was enabled in a snapshot from bin/backup but
# is disabled or uninstalled for user 0 now. It never disables anything, so
# it only undoes disables, and running it again changes nothing. When it
# re-enables the stock launcher, it makes it the default Home again.
#
# Pass a snapshot file to restore it to the TV it was taken from. Pass a TV
# name, or nothing for the first TV, to use that TV's most recent snapshot.
set -euo pipefail
source "$(dirname "$0")/../lib/tv.sh"

require_adb
arg="${1:-}"
if [[ -f "$arg" ]]; then
  snapshot="$arg"
  name="$(sed -n 's/^# tv: //p' "$snapshot" | head -n 1)"
  [[ -n "$name" ]] || die "$snapshot isn't a snapshot from bin/backup (no '# tv:' line)"
else
  entry="$(tv_lookup "$arg")"
  name="${entry%% *}"
  snapshot="$(ls "$TV_BACKUPS/$name"/*.txt 2> /dev/null | sort | tail -n 1)" \
    || true
  [[ -n "$snapshot" ]] || die "no snapshots for $name in $TV_BACKUPS/$name. Run bin/backup first."
fi
serial="$(tv_serial "$name")"
require_connected "$serial"

echo "Restoring ${snapshot#"$TV_ROOT"/} to $name ($serial)"

now="$(tv_packages "$serial")"
changed=0
stock_back=""
while read -r state pkg; do
  [[ "$state" == enabled ]] || continue
  current="$(awk -v p="$pkg" '$2 == p { print $1 }' <<< "$now")"
  case "$current" in
    enabled) continue ;;
    disabled) cmd=(pm enable --user 0 "$pkg") ;;
    uninstalled) cmd=(cmd package install-existing --user 0 "$pkg") ;;
    "") echo "skip    $pkg (no longer on the TV)"; continue ;;
  esac
  result="$(adb -s "$serial" shell "${cmd[@]}" 2>&1 | tr -d '\r')" \
    || die "'${cmd[*]}' failed: $result"
  echo "enabled $pkg (was $current)"
  changed=$((changed + 1))
  for stock in "${STOCK_LAUNCHERS[@]}"; do
    [[ "$pkg" != "$stock" ]] || stock_back="$pkg"
  done
done < <(grep -v '^#' "$snapshot")

# Projectivy stays the preferred Home until told otherwise.
if [[ -n "$stock_back" ]]; then
  component="$(home_activity_of "$serial" "$stock_back")"
  [[ -n "$component" ]] || die "the stock launcher is back but has no Home activity"
  set_home "$serial" "$component"
  echo "Made $component the default Home again"
fi

if [[ "$changed" -eq 0 ]]; then
  echo "Nothing to restore: every package enabled in the snapshot is enabled now."
else
  echo "Re-enabled $changed package(s)."
fi
