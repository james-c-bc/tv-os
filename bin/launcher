#!/usr/bin/env bash
# Usage: bin/launcher [tv-name]
# Makes our Home app (bin/home) the TV's Home screen.
#
# This firmware ignores cmd package set-home-activity: launcherx and
# setupwraith register Home above any installed app, so our app only owns
# Home once both are disabled. bin/launcher checks our app is installed,
# backs up the TV, disables both with pm disable-user --user 0, then presses
# Home and checks our app comes up. If it doesn't, it re-enables both straight
# away, so the TV is never left on a broken Home. Safe to run again, e.g.
# after a firmware update re-enables launcherx.
#
# Undo with bin/restore, which re-enables both, and launcherx wins Home back.
set -euo pipefail
source "$(dirname "$0")/../lib/tv.sh"

# Seconds to let the TV settle after pressing Home.
LAUNCHER_SETTLE="${LAUNCHER_SETTLE:-3}"

require_adb
entry="$(tv_lookup "${1:-}")"
name="${entry%% *}"
serial="${entry#* }:$ADB_PORT"
require_connected "$serial"

tv() { adb -s "$serial" shell "$@" | tr -d '\r'; }

# press_home: presses Home on the remote and prints the activity that comes
# to the front.
press_home() {
  tv input keyevent KEYCODE_HOME > /dev/null
  sleep "$LAUNCHER_SETTLE"
  tv dumpsys activity activities \
    | awk '/mResumedActivity:/ && !found { found = 1; print $(NF - 1) }'
}

# enable_stock: re-enables every stock Home package that's disabled now.
enable_stock() {
  local pkg
  now="$(tv_packages "$serial")"
  for pkg in "${STOCK_HOMES[@]}"; do
    [[ "$(state_of "$pkg")" == disabled ]] || continue
    tv pm enable --user 0 "$pkg" > /dev/null
    echo "enabled  $pkg (rolled back)"
  done
}

state_of() { awk -v p="$1" '$2 == p { print $1 }' <<< "$now"; }

now="$(tv_packages "$serial")"

[[ "$(state_of "$HOME_APP_PACKAGE")" == enabled ]] \
  || die "our Home app ($HOME_APP_PACKAGE) isn't installed and enabled. Run bin/home first."

todo=()
for pkg in "${STOCK_HOMES[@]}"; do
  case "$(state_of "$pkg")" in
    enabled) todo+=("$pkg") ;;
    disabled) echo "skip     $pkg (already disabled)" ;;
    uninstalled) echo "skip     $pkg (uninstalled; launcher leaves it)" ;;
    "") echo "skip     $pkg (not on the TV)" ;;
  esac
done

if [[ "${#todo[@]}" -gt 0 ]]; then
  "$TV_ROOT/bin/backup" "$name"
  for pkg in "${todo[@]}"; do
    result="$(adb -s "$serial" shell pm disable-user --user 0 "$pkg" 2>&1 | tr -d '\r')" \
      || true
    if [[ "$result" != *"new state: disabled-user"* ]]; then
      enable_stock
      die "'pm disable-user --user 0 $pkg' failed: $result"
    fi
    echo "disabled $pkg"
  done
fi

front="$(press_home)"
if [[ "${front%%/*}" != "$HOME_APP_PACKAGE" ]]; then
  enable_stock
  die "Home opened ${front:-nothing} instead of our Home app, so the stock" \
    "launcher is back on. Check Home opens on the TV (run bin/home to reinstall" \
    "it), then run bin/launcher again."
fi
echo "Home button lands on our Home app ($front)"

if [[ "${#todo[@]}" -eq 0 ]]; then
  echo "Nothing to disable: launcherx and setupwraith are already off."
else
  echo "Disabled ${#todo[@]} package(s). Undo with bin/restore."
fi
