#!/usr/bin/env bash
# Fake adb for tests. Behaviour is driven by env vars:
#   STUB_CONNECT  "ok" -> connect succeeds; "hang" -> connect never returns;
#                 anything else -> connect fails
#   STUB_FIRMWARE what ro.software.version_id holds (TCL-only; may be empty)
#   STUB_STATE    device state `devices` lists (unset -> no devices)
#   STUB_SERIAL   serial `devices` lists (default 192.168.1.50:5555)
#   STUB_HOME     file holding the default Home activity, which
#                 set-home-activity writes (missing -> the stock launcher)
#   STUB_FOREGROUND  activity that comes to the front when Home is pressed
#                 (unset -> the default Home)
#   STUB_BOOT_ID  the TV's boot id (default boot-1)
#   STUB_MARKER   file standing in for the TV's /data/local/tmp boot marker
#   STUB_PACKAGES file of "<state> <package>" lines (enabled, disabled or
#                 uninstalled) the pm commands read and update
# Every invocation is appended to $STUB_LOG.

echo "$*" >> "${STUB_LOG:-/dev/null}"

# set_state <state> <package>: updates a package in $STUB_PACKAGES
set_state() {
  awk -v s="$1" -v p="$2" '$2 == p { $1 = s } { print }' "$STUB_PACKAGES" \
    > "$STUB_PACKAGES.new" && mv "$STUB_PACKAGES.new" "$STUB_PACKAGES"
}

# home_of <package>: prints the package's Home activity, if it has one
home_of() {
  case "$1" in
    com.google.android.tvlauncher) echo "$1/.MainActivity" ;;
    com.google.android.apps.tv.launcherx) echo "$1/.home.HomeActivity" ;;
    com.spocky.projengmenu) echo "$1/.ui.home.MainActivity" ;;
  esac
}

home() { cat "$STUB_HOME" 2> /dev/null || echo com.google.android.tvlauncher/.MainActivity; }

serial=""
if [[ "$1" == "-s" ]]; then
  serial="$2"
  shift 2
fi

case "$1" in
  connect)
    if [[ "${STUB_CONNECT:-}" == "ok" ]]; then
      echo "connected to $2"
    elif [[ "${STUB_CONNECT:-}" == "hang" ]]; then
      exec sleep 30 # exec, so killing adb kills the sleep, as with real adb
    else
      echo "failed to connect to '$2': Connection refused"
    fi
    ;;
  devices)
    echo "List of devices attached"
    if [[ -n "${STUB_STATE:-}" ]]; then
      printf '%s\t%s\n' "${STUB_SERIAL:-192.168.1.50:5555}" "$STUB_STATE"
    fi
    echo
    ;;
  shell)
    shift
    case "$*" in
      "getprop ro.product.model") echo "Smart TV" ;;
      "getprop ro.build.version.release") echo "11" ;;
      "getprop ro.build.display.id") echo "RP1A.200622.001 release-keys" ;;
      "getprop ro.software.version_id") echo "${STUB_FIRMWARE-V8-R51MT05-LF1V620}" ;;
      "getprop ro.build.version.security_patch") echo "2024-03-05" ;;
      cmd\ package\ resolve-activity*)
        echo "priority=0 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=true"
        home
        ;;
      cmd\ package\ query-activities*)
        # Same layout as the real TV: a count, then indented entries.
        activities="$(awk '$1 == "enabled" { print $2 }' "$STUB_PACKAGES" \
          | while read -r pkg; do home_of "$pkg"; done)"
        echo "$(grep -c . <<< "$activities") activities found:"
        i=0
        while read -r activity; do
          [[ -n "$activity" ]] || continue
          echo "  Activity #$i:"
          echo "    priority=0 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=true"
          echo "    $activity"
          i=$((i + 1))
        done <<< "$activities"
        ;;
      "cmd package set-home-activity --user 0 "*)
        echo "${*: -1}" > "$STUB_HOME"
        echo "Success"
        ;;
      "input keyevent KEYCODE_HOME") ;;
      "dumpsys activity activities")
        front="${STUB_FOREGROUND:-$(home)}"
        echo "  ResumedActivity: ActivityRecord{1a2b3c u0 $front t7}"
        echo "    mResumedActivity: ActivityRecord{1a2b3c u0 $front t7}"
        echo "    mLastResumedActivity: ActivityRecord{4d5e6f u0 com.example/.Old t3}"
        ;;
      "cat /proc/sys/kernel/random/boot_id") echo "${STUB_BOOT_ID:-boot-1}" ;;
      "cat /data/local/tmp/tcl-os-home-boot-id")
        if [[ -f "$STUB_MARKER" ]]; then
          cat "$STUB_MARKER"
        else
          echo "cat: /data/local/tmp/tcl-os-home-boot-id: No such file or directory" >&2
          exit 1
        fi
        ;;
      "cp /proc/sys/kernel/random/boot_id /data/local/tmp/tcl-os-home-boot-id")
        echo "${STUB_BOOT_ID:-boot-1}" > "$STUB_MARKER" ;;
      "pm list packages -u --user 0")
        awk '{ print "package:" $2 }' "$STUB_PACKAGES" ;;
      "pm list packages --user 0")
        awk '$1 != "uninstalled" { print "package:" $2 }' "$STUB_PACKAGES" ;;
      "pm list packages -d --user 0")
        awk '$1 == "disabled" { print "package:" $2 }' "$STUB_PACKAGES" ;;
      "pm disable-user --user 0 "*)
        pkg="${*: -1}"
        set_state disabled "$pkg"
        echo "Package $pkg new state: disabled-user"
        ;;
      "pm enable --user 0 "*)
        pkg="${*: -1}"
        set_state enabled "$pkg"
        echo "Package $pkg new state: enabled"
        ;;
      "cmd package install-existing --user 0 "*)
        pkg="${*: -1}"
        set_state enabled "$pkg"
        echo "Package $pkg installed for user: 0"
        ;;
      *) echo "stub adb: unexpected shell command: $*" >&2; exit 1 ;;
    esac
    ;;
  *)
    echo "stub adb: unexpected command: $*" >&2
    exit 1
    ;;
esac
